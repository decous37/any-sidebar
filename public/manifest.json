{
  "manifest_version": 3,
  "name": "Any Sidebar",
  "version": "0.2.2",
  "description": "围绕当前文章与 DeepSeek 对话。自备 API Key，正文优先、本机保存、网页会话隔离。",
  "minimum_chrome_version": "142",
  "incognito": "not_allowed",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开Any Sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; connect-src https://api.deepseek.com; img-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none';"
  }
}
